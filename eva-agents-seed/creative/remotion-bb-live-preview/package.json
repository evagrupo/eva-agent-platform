{
  "name": "bb-plugin-remotion-live-preview",
  "version": "1.0.0",
  "description": "Preview multiple Remotion compositions live in BB's native side panel.",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "bb": ">=0.40",
    "bbPluginSdk": ">=0.4.47"
  },
  "bb": {
    "name": "Remotion Live Preview",
    "description": "Preview multiple Remotion compositions live in BB's native side panel.",
    "branding": {
      "icon": "Play"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.523",
    "@remotion/cli": "4.0.523",
    "@remotion/lambda": "4.0.523",
    "@remotion/player": "4.0.523",
    "@remotion/tailwind-v4": "4.0.523",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.523",
    "tailwindcss": "4.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.47",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@remotion/eslint-config-flat": "4.0.523",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "^19.0.0",
    "@types/web": "0.0.166",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "9.19.0",
    "jsdom": "^26.1.0",
    "prettier": "3.8.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "5.9.3",
    "vaul": "^1.1.2",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "dev": "remotion studio --no-open",
    "bb:dev": "bb plugin dev",
    "build": "remotion bundle",
    "build:plugin": "bb plugin build",
    "check:plugin": "bb plugin types --check",
    "lambda:setup": "bash scripts/with-remotion-env.sh node scripts/remotion-lambda.mjs setup",
    "lambda:render": "bash scripts/with-remotion-env.sh node scripts/remotion-lambda.mjs render",
    "lambda:status": "bash scripts/with-remotion-env.sh node scripts/remotion-lambda.mjs status",
    "upgrade": "remotion upgrade",
    "lint": "eslint src app.tsx server.ts && tsc --noEmit",
    "test": "vitest run"
  },
  "sideEffects": [
    "*.css"
  ]
}
