# Never commit real credentials. The CLI reads these values from the process
# environment and never accepts them as command-line arguments.
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Optional data-residency endpoint. Defaults to https://api.elevenlabs.io
# ELEVENLABS_BASE_URL=https://api.eu.residency.elevenlabs.io

# Required before starting the local manager webhook service. Generate/store
# this with an operator secret manager; never dictate it to the voice agent.
# ELEVENLABS_MANAGER_SHARED_SECRET=local-manager-shared-secret

# Optional operator-controlled HTTPS tunnel base URL for setup-manager. Do not
# put a secret in this URL. Localhost is rejected by the setup command.
# ELEVENLABS_MANAGER_TOOL_URL=https://operator-controlled-tunnel.example

# Optional separate post-call listener secret. Configure it out of band; the
# listener verifies ElevenLabs-Signature and never logs event contents.
# ELEVENLABS_POST_CALL_WEBHOOK_SECRET=post-call-secret

# Phone import is disabled unless explicitly enabled and provider setup exists.
# ELEVENLABS_ALLOW_PHONE_IMPORT=0
# ELEVENLABS_TWILIO_SID=...
# ELEVENLABS_TWILIO_TOKEN=...
# ELEVENLABS_EXOTEL_CONFIG_JSON={}
# ELEVENLABS_SIP_TRUNK_CONFIG_JSON={}
